rules_version = '2';

// Defesa em profundidade só — o backend (Vercel Functions + Firebase Admin
// SDK) é a fonte de verdade pra autorização e sempre contorna estas regras
// via Admin SDK. Elas existem só pra bloquear qualquer acesso direto do SDK
// cliente aos dados de outro usuário — nenhuma escrita direta do cliente é
// permitida em nenhuma coleção (o backend sempre escreve por trás do
// requireAuth() de cada rota).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource);
      allow write: if false;
    }

    match /presentations/{presentationId} {
      allow read: if isOwner(resource);
      allow write: if false;
    }

    match /presentation_versions/{versionId} {
      // Não tem ownerId direto (referencia presentationId) — sem leitura
      // direta do cliente; a rota /presentations/:id/versions já filtra
      // por dono da apresentação antes de devolver.
      allow read, write: if false;
    }

    match /media/{mediaId} {
      allow read: if isOwner(resource);
      allow write: if false;
    }

    // Templates são biblioteca compartilhada pra leitura (Template Matcher
    // e Template Editor de qualquer usuário autenticado precisam ver todos
    // pra montar a lista) — escrita sempre via backend, que checa dono.
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // settings, ai_generations: nunca lidos/escritos direto por client SDK.
    match /settings/{scope} {
      allow read, write: if false;
    }
    match /ai_generations/{docId} {
      allow read, write: if false;
    }
  }
}
