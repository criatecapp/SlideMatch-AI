# ---------------------------------------------------------------------------
# SlideMatch AI — variáveis de ambiente do /api (Vercel Functions)
# Copy to .env e preencha. Nunca commitar .env.
# Usado por `vercel dev` (lido automaticamente na raiz do repo).
# ---------------------------------------------------------------------------

# Firebase Admin SDK — conteúdo integral do JSON do service account, numa
# linha só (Project Settings > Service Accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# OpenAI — usado a partir do sub-projeto de IA (Fase 4 da migração)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
