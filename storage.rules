rules_version = '2';

// Defesa em profundidade — o backend usa o Admin SDK (contorna estas
// regras) pra gerar signed URLs e ler/escrever objetos. Estas regras
// existem só pra garantir que o client SDK nunca lê o arquivo de outro
// usuário direto. Layout: users/{userId}/projects/{projectId}/{images|exports}/...
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
