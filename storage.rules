rules_version = '2';

// Defense in depth only — the backend uses the Admin SDK (bypasses these
// rules) to generate signed URLs and to read/write objects. These rules
// exist so a client SDK can never read another user's files directly.
// Layout: users/{userId}/projects/{projectId}/{images|assets|exports}/...
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
